{
  "name": "abc-utils",
  "version": "0.1.0",
  "type": "module",
  "description": "A standalone, zero-dependency, pure TypeScript library for ABC Music Notation (v2.1) parsing, manipulation, transposition, and MusicXML 4.0 conversion.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./abc2xml": {
      "import": {
        "types": "./dist/converters/abc2xml/index.d.ts",
        "default": "./dist/converters/abc2xml/index.js"
      },
      "require": {
        "types": "./dist/converters/abc2xml/index.d.cts",
        "default": "./dist/converters/abc2xml/index.cjs"
      }
    },
    "./parser": {
      "import": {
        "types": "./dist/parser/index.d.ts",
        "default": "./dist/parser/index.js"
      },
      "require": {
        "types": "./dist/parser/index.d.cts",
        "default": "./dist/parser/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./operations": {
      "import": {
        "types": "./dist/operations/index.d.ts",
        "default": "./dist/operations/index.js"
      },
      "require": {
        "types": "./dist/operations/index.d.cts",
        "default": "./dist/operations/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm run test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [

    "abc",
    "abc-notation",
    "musicxml",
    "musicxml4",
    "sheet-music",
    "music-notation",
    "abc2xml",
    "xml2abc",
    "music-theory",
    "transpose",
    "parser"
  ],
  "author": "Kevin",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@vitest/coverage-v8": "^3.0.6",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
