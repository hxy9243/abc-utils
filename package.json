{
  "name": "abc2xml-ts",
  "version": "0.1.0",
  "description": "A standalone, zero-dependency, pure TypeScript library for converting ABC Music Notation (v2.1) into MusicXML 4.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "abc",
    "musicxml",
    "music-notation",
    "musicxml4",
    "sheet-music",
    "abc2xml",
    "abcjs",
    "parser"
  ],
  "author": "Kevin",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@vitest/coverage-v8": "^3.0.6",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
